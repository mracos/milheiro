{
  "name": "milheiro",
  "version": "0.1.0",
  "description": "Browser extension: milhas ou reais? Tells you whether to pay a flight in miles or cash, comparing R$/milheiro against your baseline.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:safari": "bash scripts/build-safari.sh",
    "dev": "node build.mjs --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0"
  }
}
