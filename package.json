{
  "name": "milheiro",
  "version": "0.1.0",
  "description": "Browser extension: milhas ou reais? Tells you whether to pay a flight in miles or cash, comparing R$/milheiro against your baseline.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test test/integration/latam.test.ts",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@wxt-dev/auto-icons": "^1.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "prettier": "^3.9.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.66.0",
    "wxt": "^0.21.3",
    "wxt-module-safari-install": "*",
    "wxt-module-safari-xcode": "^0.2.2"
  }
}
